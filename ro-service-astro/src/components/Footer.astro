---
// Footer.astro
---
<footer class="bg-slate-900 text-white pt-12 pb-6">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
      
      <!-- Column 1: Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="bg-blue-900 p-2 rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
            </svg>
          </div>
          <span class="text-xl font-extrabold text-white">Rofix Service</span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          Your trusted partner for pure, safe water. Professional RO services with genuine parts and certified technicians in Bangalore.
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h4 class="text-lg font-bold mb-4 text-yellow-400">Quick Links</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/" class="hover:text-white transition">Home</a></li>
          <li><a href="/#services" class="hover:text-white transition">Our Services</a></li>
          <li><a href="/blog" class="hover:text-white transition">Blog</a></li>
          <li><a href="/#faq" class="hover:text-white transition">FAQ</a></li>
          <li><a href="/contact" class="hover:text-white transition">Contact Us</a></li>
          <li><a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition">Terms & Conditions</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact -->
      <div>
        <h4 class="text-lg font-bold mb-4 text-yellow-400">Contact Us</h4>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-yellow-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:+917090170092" class="hover:text-white transition">+91-7090170092</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-yellow-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="/contact" class="hover:text-white transition">Contact Page</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-yellow-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>Bangalore, Karnataka</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-yellow-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Mon - Sun: 9:00 AM - 8:00 PM</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Disclaimer - Google Ads Compliant -->
    <div class="border-t border-slate-700 pt-6 pb-4">
      <p class="text-[11px] text-slate-500 leading-relaxed text-center max-w-3xl mx-auto">
        <strong class="text-slate-400">Disclaimer:</strong> Rofix Service is an independent service provider. All brand names, logos, and trademarks belong to their respective owners and are used for identification purposes only. We are not affiliated with, authorized by, or endorsed by any brand mentioned on this website.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-700 pt-4 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <p>© 2026 Rofix Service. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition">Terms & Conditions</a>
      </div>
    </div>

  </div>
</footer>