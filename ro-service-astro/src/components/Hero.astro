---
// Hero.astro - Homepage Hero with Booking Form (SEO + Ads Optimized) + Background Image
---
<section class="relative w-full bg-slate-50 pt-6 pb-12 md:pt-10 md:pb-16 px-4 overflow-hidden">

  <!-- ✅ Background Image -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-bg.jpg" 
      alt="Expert RO Repair & Service in Bangalore"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-white/95 via-white/85 to-white/95 md:bg-gradient-to-r md:from-white/95 md:via-white/80 md:to-white/70"></div>
  </div>

  <!-- Subtle Background Glow -->
  <div class="absolute top-[-10%] right-[-10%] w-96 h-96 bg-blue-100 rounded-full mix-blend-multiply filter blur-3xl opacity-40"></div>
  <div class="absolute bottom-[-10%] left-[-10%] w-96 h-96 bg-yellow-50 rounded-full mix-blend-multiply filter blur-3xl opacity-40"></div>

  <div class="relative z-10 max-w-md mx-auto">
    
    <!-- Header Section -->
    <div class="text-center mb-6">
      
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 bg-blue-900 border border-blue-800 text-white text-xs font-bold px-4 py-2 rounded-full shadow-md mb-4">
        <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
        Trusted RO Service in Bangalore
      </div>

      <!-- Small Tag - SEO -->
      <p class="text-[10px] md:text-xs font-bold uppercase tracking-wider text-blue-700 mb-2">
        RO SERVICE NEAR ME | SAME-DAY DOORSTEP REPAIR
      </p>

      <!-- Main Heading - SEO + Ads -->
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 leading-tight tracking-tight">
        Expert <span class="text-blue-900">RO Repair</span> &amp; Service
      </h1>
      
      <!-- Price Hook -->
      <p class="mt-2 text-base md:text-xl font-bold text-blue-600">
        Starting at ₹299 Only
      </p>

      <p class="mt-3 text-slate-600 text-sm md:text-base max-w-md mx-auto">
        Same-day doorstep service in Bangalore. Certified technicians, genuine spare parts, and 90-day service warranty. 20,000+ happy customers.
      </p>

      <!-- Feature Pills -->
      <div class="mt-6 flex flex-wrap justify-center gap-2 text-xs md:text-sm">
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 text-slate-700 px-3 py-1.5 rounded-full shadow-sm font-medium">
          <svg class="w-3.5 h-3.5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Same Day Service
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 text-slate-700 px-3 py-1.5 rounded-full shadow-sm font-medium">
          <svg class="w-3.5 h-3.5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          All Brands
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 text-slate-700 px-3 py-1.5 rounded-full shadow-sm font-medium">
          <svg class="w-3.5 h-3.5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Doorstep Repair
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white border border-slate-200 text-slate-700 px-3 py-1.5 rounded-full shadow-sm font-medium">
          <svg class="w-3.5 h-3.5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          24/7 Support
        </span>
      </div>
    </div>

    <!-- Register Service Request Heading -->
    <h2 class="text-2xl md:text-3xl font-bold text-blue-900 text-center leading-tight mt-8 mb-2">
      Register Service Request
    </h2>

    <p class="text-sm text-slate-500 text-center mb-6 leading-relaxed max-w-sm mx-auto">
      Fill the form below and our team will call you back within <strong class="text-slate-700">30 minutes</strong>. Same-day doorstep service available.
    </p>

    <!-- Booking Form Card -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 border-t-4 border-t-blue-900 p-6 md:p-8">
      <form id="bookingForm" class="space-y-4">
        
        <input type="text" id="fullName" name="name" placeholder="Your Full Name" class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
        
        <input type="tel" id="mobile" name="mobile" placeholder="Mobile Number" class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
        
        <input type="text" id="pincode" name="pincode" placeholder="PinCode" class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
        
        <input type="text" id="address" name="address" placeholder="Full Address" class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
        
        <select id="serviceType" name="service" class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm cursor-pointer" required>
          <option value="" disabled selected>Select Brand</option>
          <option value="Kent">Kent</option>
          <option value="Aquaguard">Aquaguard</option>
          <option value="Pureit">Pureit</option>
          <option value="LG">LG</option>
          <option value="AO Smith">AO Smith</option>
          <option value="Livpure">Livpure</option>
          <option value="Blue Star">Blue Star</option>
          <option value="Havells">Havells</option>
          <option value="Others">Others</option>
        </select>

        <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-extrabold p-3.5 rounded-xl transition duration-300 shadow-md text-sm mt-2">
          Book Service Now
        </button>
      </form>

      <!-- Trust Indicators -->
      <div class="mt-5 flex justify-center items-center gap-4 text-[11px] text-slate-500 font-medium">
        <span class="flex items-center gap-1">
          <svg class="w-3 h-3 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          100% Secure
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-3 h-3 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Instant Callback
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-3 h-3 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          No Hidden Charges
        </span>
      </div>
    </div>

    <!-- Bottom Call Option -->
    <div class="text-center mt-8">
      <p class="text-xs text-slate-500 mb-2">Need urgent help?</p>
      <a href="tel:+917090170092" class="inline-flex items-center gap-2 bg-white border border-slate-300 text-blue-900 font-bold py-3 px-6 rounded-xl shadow-sm hover:shadow-md transition duration-300 text-sm">
        <svg class="w-4 h-4 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        Call: +91-7090170092
      </a>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('bookingForm');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const now = new Date();
    const dateStr = now.getFullYear().toString() + 
                    String(now.getMonth() + 1).padStart(2, '0') + 
                    String(now.getDate()).padStart(2, '0');
    const randomNum = Math.floor(1000 + Math.random() * 9000);
    const bookingId = 'RFX-' + dateStr + '-' + randomNum;
    sessionStorage.setItem('bookingId', bookingId);
    
    const formData = new FormData(form);
    
    try {
      await fetch('https://formsubmit.co/ajax/syedsmaula786@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          'Brand': formData.get('service'),
          'Booking ID': bookingId,
          'Name': formData.get('name'),
          'Mobile': formData.get('mobile'),
          'Pincode': formData.get('pincode'),
          'Address': formData.get('address'),
          _subject: 'New Homepage Booking ' + bookingId + ' - ' + formData.get('name'),
          _template: 'table'
        })
      });
      window.location.href = '/thank-you';
    } catch (error) {
      console.error('Form submit error:', error);
      window.location.href = '/thank-you';
    }
  });
</script>