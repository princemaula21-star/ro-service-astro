---
// Services.astro
---
<section id="services" class="py-16 md:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">
        Our <span class="text-blue-900">Services</span>
      </h2>
      <p class="mt-3 text-slate-600 text-sm md:text-base max-w-xl mx-auto">
        From filter replacement to full system check-up, get comprehensive RO service without leaving your home.
      </p>
    </div>

    <!-- Services Grid (4 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Card 1: Installation -->
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition duration-300 text-center">
        <div class="bg-blue-100 w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">RO Installation</h3>
        <p class="text-sm text-slate-600">New RO water purifier installation at your home with proper setup.</p>
      </div>

      <!-- Card 2: Repair & Service -->
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition duration-300 text-center">
        <div class="bg-yellow-100 w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">RO Repair & Service</h3>
        <p class="text-sm text-slate-600">Expert repair for all RO brands with genuine spare parts and warranty.</p>
      </div>

      <!-- Card 3: Filter Change -->
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition duration-300 text-center">
        <div class="bg-teal-100 w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">Filter Replacement</h3>
        <p class="text-sm text-slate-600">Timely filter and membrane replacement for crystal clear water.</p>
      </div>

      <!-- Card 4: AMC -->
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition duration-300 text-center">
        <div class="bg-purple-100 w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 mb-2">AMC Plans</h3>
        <p class="text-sm text-slate-600">Annual Maintenance Contracts for hassle-free RO servicing.</p>
      </div>

    </div>

    <!-- Call to Action Button -->
    <div class="text-center mt-10">
      <a href="tel:+917090170092" class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3.5 px-8 rounded-xl shadow-md transition duration-300 text-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        Call Now for Service
      </a>
    </div>

  </div>
</section>