---
// Stats.astro
---
<section class="py-14 md:py-20 bg-gradient-to-br from-blue-900 via-blue-800 to-blue-900 text-white">
  <div class="max-w-6xl mx-auto px-4">
    
    <!-- Section Header -->
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-extrabold">
        Trusted by <span class="text-yellow-400">Thousands of Families</span>
      </h2>
      <p class="mt-2 text-blue-100 text-sm md:text-base">
        Numbers that speak for our quality and service
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      
      <!-- Stat 1: Rating -->
      <div class="text-center bg-white/10 backdrop-blur-sm rounded-xl p-5 md:p-6 border border-white/10">
        <div class="text-3xl md:text-4xl font-extrabold text-yellow-400">4.8★</div>
        <p class="mt-2 text-sm md:text-base font-semibold text-white">Average Rating</p>
        <p class="text-xs text-blue-200 mt-1">Based on 150+ reviews</p>
      </div>

      <!-- Stat 2: Happy Customers -->
      <div class="text-center bg-white/10 backdrop-blur-sm rounded-xl p-5 md:p-6 border border-white/10">
        <div class="text-3xl md:text-4xl font-extrabold text-yellow-400">17,113+</div>
        <p class="mt-2 text-sm md:text-base font-semibold text-white">Happy Customers</p>
        <p class="text-xs text-blue-200 mt-1">Across all major cities</p>
      </div>

      <!-- Stat 3: Repeat Customers -->
      <div class="text-center bg-white/10 backdrop-blur-sm rounded-xl p-5 md:p-6 border border-white/10">
        <div class="text-3xl md:text-4xl font-extrabold text-yellow-400">84%</div>
        <p class="mt-2 text-sm md:text-base font-semibold text-white">Repeat Customers</p>
        <p class="text-xs text-blue-200 mt-1">Customer retention rate</p>
      </div>

      <!-- Stat 4: Response Time -->
      <div class="text-center bg-white/10 backdrop-blur-sm rounded-xl p-5 md:p-6 border border-white/10">
        <div class="text-3xl md:text-4xl font-extrabold text-yellow-400">24h</div>
        <p class="mt-2 text-sm md:text-base font-semibold text-white">Response Time</p>
        <p class="text-xs text-blue-200 mt-1">Emergency service</p>
      </div>

    </div>

    <!-- Bottom Line -->
    <div class="mt-10 text-center">
      <p class="text-blue-100 text-sm">
        Join thousands of satisfied customers who trust <strong class="text-white">Rofix Service</strong> for their RO water purifier needs.
      </p>
    </div>

  </div>
</section>