---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<Layout>
  <main class="bg-white">
    
    <!-- BLOG HEADER -->
    <section class="py-12 md:py-16 px-4 bg-gradient-to-b from-blue-50 to-white">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-[11px] uppercase tracking-widest text-blue-600 font-semibold mb-3">Rofix Service Blog</p>
        <h1 class="text-3xl md:text-5xl font-bold text-slate-900 leading-tight tracking-tight">
          Expert RO Water Purifier <span class="text-blue-600">Guides & Tips</span>
        </h1>
        <p class="mt-4 text-slate-600 text-sm md:text-base leading-relaxed max-w-xl mx-auto">
          Practical advice on RO maintenance, repair, water quality, and choosing the right purifier for Bangalore homes.
        </p>
      </div>
    </section>

    <!-- BLOG POSTS GRID -->
    <section class="py-12 px-4">
      <div class="max-w-5xl mx-auto">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          {sortedPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="group block bg-white rounded-2xl border border-slate-200 hover:border-blue-300 hover:shadow-lg transition-all duration-300 overflow-hidden">
              
              <div class="p-6">
                
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full">
                    {post.data.tags[0] || 'Guide'}
                  </span>
                  <span class="text-[10px] text-slate-400">{post.data.readTime}</span>
                </div>
                
                <h2 class="text-lg font-bold text-slate-900 leading-snug mb-2 group-hover:text-blue-600 transition">
                  {post.data.title}
                </h2>
                
                <p class="text-sm text-slate-600 leading-relaxed mb-4 line-clamp-3">
                  {post.data.description}
                </p>
                
                <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                  <span class="text-xs text-slate-400">
                    {new Date(post.data.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                  <span class="text-xs font-semibold text-blue-600 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    Read
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </span>
                </div>
                
              </div>
            </a>
          ))}
          
        </div>
      </div>
    </section>

    <!-- CTA SECTION -->
    <section class="py-16 px-4 bg-blue-900">
      <div class="max-w-md mx-auto text-center">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3">
          Need RO Service in Bangalore?
        </h2>
        <p class="text-blue-200 text-sm mb-6">
          Same-day doorstep service. Genuine parts. 90-day warranty.
        </p>
        <a href="tel:+917090170092" class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-bold py-3.5 px-8 rounded-md transition duration-300 text-sm tracking-wide">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Call +91-7090170092
        </a>
      </div>
    </section>

    <Footer />
  </main>
</Layout>