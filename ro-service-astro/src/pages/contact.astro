---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="py-16 px-4 bg-slate-50 min-h-screen">
    <div class="max-w-5xl mx-auto">
      
      <!-- Page Header -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900">
          Contact <span class="text-blue-900">Rofix Service</span>
        </h1>
        <p class="mt-3 text-slate-600 text-sm md:text-base max-w-xl mx-auto">
          We're here to help! Reach out to us for any RO service inquiry, booking, or support. Our team responds within 30 minutes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- LEFT: Contact Info -->
        <div class="space-y-4">
          
          <!-- Phone Card -->
          <a href="tel:+919008315606" class="block bg-white rounded-xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition duration-300">
            <div class="flex items-start gap-4">
              <div class="bg-blue-100 p-3 rounded-lg shrink-0">
                <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-lg">Call Us</h3>
                <p class="text-slate-600 text-sm mt-1">+91-9008315606</p>
                <p class="text-xs text-slate-500 mt-1">Available 9 AM - 8 PM</p>
              </div>
            </div>
          </a>

          <!-- WhatsApp Card -->
          <a href="https://wa.me/919008315606" target="_blank" class="block bg-white rounded-xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition duration-300">
            <div class="flex items-start gap-4">
              <div class="bg-green-100 p-3 rounded-lg shrink-0">
                <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-lg">WhatsApp</h3>
                <p class="text-slate-600 text-sm mt-1">+91-9008315606</p>
                <p class="text-xs text-slate-500 mt-1">Chat with us instantly</p>
              </div>
            </div>
          </a>

          <!-- Location Card -->
          <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
            <div class="flex items-start gap-4">
              <div class="bg-yellow-100 p-3 rounded-lg shrink-0">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-lg">Service Area</h3>
                <p class="text-slate-600 text-sm mt-1">Bangalore, Karnataka</p>
                <p class="text-xs text-slate-500 mt-1">All areas within 25 km radius</p>
              </div>
            </div>
          </div>

          <!-- Hours Card -->
          <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
            <div class="flex items-start gap-4">
              <div class="bg-purple-100 p-3 rounded-lg shrink-0">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 text-lg">Working Hours</h3>
                <p class="text-slate-600 text-sm mt-1">Mon - Sun: 9:00 AM - 8:00 PM</p>
                <p class="text-xs text-slate-500 mt-1">Emergency service available</p>
              </div>
            </div>
          </div>

        </div>

        <!-- RIGHT: Contact Form -->
        <div class="bg-white rounded-2xl shadow-xl border border-slate-200 border-t-4 border-t-blue-900 p-6 md:p-8">
          <h3 class="text-2xl font-bold text-slate-900 mb-1">Send Us a Message</h3>
          <p class="text-slate-500 text-sm mb-6">Fill the form below and we'll get back to you shortly.</p>

          <form id="contactForm" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Full Name</label>
              <input type="text" placeholder="Enter your full name" class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Mobile Number</label>
              <input type="tel" placeholder="10-digit mobile number" class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Service Type</label>
              <select class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm cursor-pointer" required>
                <option value="" disabled selected>Select service type</option>
                <option value="RO Installation">RO Installation</option>
                <option value="RO Repair">RO Repair</option>
                <option value="Filter Replacement">Filter Replacement</option>
                <option value="AMC Plan">AMC Plan</option>
                <option value="General Inquiry">General Inquiry</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">Message</label>
              <textarea rows="4" placeholder="Tell us about your issue..." class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm resize-none" required></textarea>
            </div>

            <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-extrabold p-3.5 rounded-xl transition duration-300 shadow-md text-sm mt-2">
              Send Message
            </button>
          </form>
        </div>

      </div>

    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Thank you! Aapka message bhej diya gaya hai. Hum jaldi contact karenge.');
    form.reset();
  });
</script>