---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const brandName = 'LG';
---
<Layout>
  <main class="bg-white">
    
    <!-- TOP CONTENT SECTION - SEO Optimized -->
    <section class="pt-6 pb-6 px-4 bg-white">
      <div class="max-w-3xl mx-auto">
        
        <h1 class="text-2xl md:text-4xl font-bold text-slate-900 leading-tight tracking-tight">
          LG Water Purifier Service in Bangalore
        </h1>
        
        <p class="mt-3 text-sm md:text-base text-slate-600 leading-relaxed">
          Facing low water flow or unusual taste from your LG purifier? Rofix Service is your trusted independent service provider for all LG water purifier models. We handle installation, repair, filter replacement, and annual maintenance — all at your doorstep in Bangalore.
        </p>

        <div class="mt-4 flex items-center gap-2 text-sm">
          <span class="text-yellow-500 tracking-wider">★★★★★</span>
          <span class="text-slate-900 font-bold">4.8</span>
          <span class="text-slate-300">|</span>
          <span class="text-slate-600">20,000+ happy customers</span>
        </div>

      </div>
    </section>

    <!-- FORM SECTION -->
    <section class="pb-10 md:pb-14 px-4 bg-white">
      <div class="max-w-md mx-auto">
        
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
          <img 
            src="/lg-service.jpg" 
            alt="Water Purifier Service"
            width="800" height="600" loading="lazy" class="w-full h-56 md:h-64 object-cover"
          />
        </div>

        <h2 class="text-2xl md:text-3xl font-bold text-blue-900 text-center leading-tight mt-8 mb-2">
          Register Service Request
        </h2>

        <p class="text-sm text-slate-500 text-center mb-6 leading-relaxed max-w-sm mx-auto">
          Fill the form below and our team will call you back within <strong class="text-slate-700">30 minutes</strong>. Same-day doorstep service available.
        </p>

        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          
          <div class="bg-blue-900 text-white text-center py-3">
            <p class="text-xs font-semibold tracking-widest uppercase">Book Your Service</p>
          </div>

          <form id="bookingForm" class="p-5 md:p-6 space-y-3">
            
            <input type="text" id="fullName" name="name" placeholder="Your Full Name" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <input type="tel" id="mobile" name="mobile" placeholder="Mobile Number" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <input type="text" id="pincode" name="pincode" placeholder="PinCode" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <input type="text" id="address" name="address" placeholder="Full Address" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <select id="serviceType" name="service" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm cursor-pointer" required>
              <option value="" disabled selected>Select Service Type</option>
              <option value="LG Water Purifier Service">LG Water Purifier Service</option>
              <option value="LG Water Purifier Repair">LG Water Purifier Repair</option>
              <option value="LG Water Purifier Installation">LG Water Purifier Installation</option>
              <option value="LG Water Purifier AMC Plan">LG Water Purifier AMC Plan</option>
              <option value="LG Filter Replacement">LG Filter Replacement</option>
            </select>

            <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3.5 rounded-md transition duration-300 text-sm tracking-wide">
              Book Service Now
            </button>

            <p class="text-[11px] text-slate-500 text-center flex items-center justify-center gap-1.5 pt-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              100% secure. We never share your data.
            </p>
          </form>
        </div>

      </div>
    </section>

    <!-- DIVIDER -->
    <div class="max-w-md mx-auto px-4">
      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-slate-200"></div>
        <div class="text-slate-300 text-xs">◆</div>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>
    </div>

    <!-- TRUST HEADLINE + STATS -->
    <section class="py-8 px-4 bg-white">
      <div class="max-w-md mx-auto text-center">
        
        <p class="text-sm md:text-base text-slate-600 leading-relaxed mb-4">
          <strong class="text-slate-900">Our LG Water Purifier Service in Bangalore</strong>
        </p>

        <!-- Stats Row -->
        <div class="grid grid-cols-3 gap-3">
          <div>
            <p class="text-xl md:text-2xl font-bold text-blue-900">15+</p>
            <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wide">Years Experience</p>
          </div>
          <div>
            <p class="text-xl md:text-2xl font-bold text-blue-900">20,000+</p>
            <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wide">Happy Families</p>
          </div>
          <div>
            <p class="text-xl md:text-2xl font-bold text-blue-900">4.8★</p>
            <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wide">Average Rating</p>
          </div>
        </div>

        <p class="text-xs md:text-sm text-slate-500 mt-4 leading-relaxed">
          Certified technicians · Genuine spare parts · Transparent pricing · 90-day service warranty
        </p>
      </div>
    </section>

    <!-- TRUST IMAGE SECTION -->
    <section class="py-6 px-4 bg-white">
      <div class="max-w-md mx-auto">
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
          <img 
            src="/trust-image.jpg" 
            alt="Certified RO Technician"
            width="800" height="600" loading="lazy" class="w-full h-52 md:h-60 object-cover"
          />
        </div>
        <div class="mt-4 text-center">
          <p class="text-sm font-semibold text-slate-700">Certified & Verified Technicians</p>
          <p class="text-xs text-slate-500 mt-1">Trained on all major water purifier brands</p>
        </div>
      </div>
    </section>

    <!-- DIVIDER -->
    <div class="max-w-md mx-auto px-4">
      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-slate-200"></div>
        <div class="text-slate-300 text-xs">◆</div>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>
    </div>

    <!-- TRUST POINTS -->
    <section class="py-10 px-4">
      <div class="max-w-md mx-auto grid grid-cols-3 gap-3 text-center">
        
        <div>
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <p class="text-xs font-bold text-slate-900">Same Day</p>
          <p class="text-[10px] text-slate-500 mt-0.5">Service</p>
        </div>

        <div>
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <p class="text-xs font-bold text-slate-900">Genuine</p>
          <p class="text-[10px] text-slate-500 mt-0.5">Parts</p>
        </div>

        <div>
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <p class="text-xs font-bold text-slate-900">90-Day</p>
          <p class="text-[10px] text-slate-500 mt-0.5">Warranty</p>
        </div>

      </div>
    </section>

    <!-- SEO CONTENT SECTION -->
    <section class="py-12 px-4 bg-white border-t border-slate-100">
      <div class="max-w-3xl mx-auto">
        
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
          Everything You Need to Know About LG Purifier Service
        </h2>
        
        <div class="space-y-4 text-sm md:text-base text-slate-600 leading-relaxed">
          
          <p>
            LG is one of the most trusted water purifier brands in India, known for its advanced purification technology and smart features. However, like any water purifier, LG purifiers require regular servicing to maintain peak performance — especially in a city like Bangalore where water TDS often exceeds 500 ppm.
          </p>

          <p>
            At Rofix Service, we have over 15 years of experience servicing LG water purifiers across Bangalore. Our certified technicians are trained on all LG models, including PuriCare, WW系列, and all RO, UV, and UF variants. Whether you need a quick filter replacement or a complex motor repair, we handle everything at your doorstep.
          </p>

          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-3">
            Common LG Purifier Problems We Fix
          </h3>

          <ul class="space-y-2 list-disc pl-5">
            <li><strong>Slow water flow</strong> — Clogged sediment or carbon filter</li>
            <li><strong>Bad taste or smell</strong> — Exhausted post-carbon filter</li>
            <li><strong>TDS levels rising</strong> — Membrane degradation</li>
            <li><strong>Motor not running</strong> — Pump failure or electrical issue</li>
            <li><strong>Water leakage</strong> — Worn O-rings or cracked housing</li>
            <li><strong>Frequent beeping</strong> — Filter change alert or sensor issue</li>
            <li><strong>UV lamp not working</strong> — UV tube or ballast failure</li>
          </ul>

          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-3">
            Why Choose Rofix Service for Your LG Purifier?
          </h3>

          <ul class="space-y-2 list-disc pl-5">
            <li><strong>Certified technicians</strong> — Trained on all LG models</li>
            <li><strong>Genuine spare parts</strong> — 100% authentic with manufacturer warranty</li>
            <li><strong>Same-day service</strong> — Book before 2 PM, service today</li>
            <li><strong>Transparent pricing</strong> — Written quote before work begins</li>
            <li><strong>90-day warranty</strong> — On all repairs and spare parts</li>
            <li><strong>Doorstep service</strong> — No need to carry your purifier anywhere</li>
          </ul>

          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-3">
            How Often Should You Service Your LG Purifier?
          </h3>

          <p>
            In Bangalore's water conditions, we recommend servicing your LG purifier <strong>every 4-6 months</strong>. Filters and membranes should be replaced as per the manufacturer's guidelines — typically once a year. Regular servicing not only keeps your water safe but also extends the life of your purifier by 3-5 years.
          </p>

          <p>
            If you notice any of these signs, book a service immediately: slow water flow, unusual taste, TDS above 150 ppm, or any leakage. Ignoring these signs can lead to expensive repairs later.
          </p>

        </div>
      </div>
    </section>

    <!-- SERVICES SIMPLE LIST -->
    <section id="services" class="py-12 px-4 bg-slate-50 border-y border-slate-100">
      <div class="max-w-md mx-auto">
        
        <div class="text-center mb-6">
          <p class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold mb-1">What We Offer</p>
          <h2 class="text-xl font-bold text-slate-900">
            Our LG Water Purifier Services
          </h2>
        </div>

        <div class="space-y-2">
          
          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Installation of all LG models</span>
          </div>

          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Repair of leaks, motor & TDS issues</span>
          </div>

          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Filter & membrane replacement</span>
          </div>

          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Affordable AMC plans for LG purifiers</span>
          </div>

        </div>

      </div>
    </section>

    <!-- FAQ SECTION -->
    <section id="faq" class="py-12 md:py-16 px-4 bg-white">
      <div class="max-w-3xl mx-auto">
        
        <div class="text-center mb-8">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-3">
            Frequently Asked <span class="text-blue-600">Questions</span>
          </h2>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed max-w-xl mx-auto">
            Common questions about LG water purifier service in Bangalore.
          </p>
        </div>

        <div class="space-y-3">
          
          <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none">
              <div class="flex items-center gap-3 pr-4">
                <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="font-medium text-slate-900 text-sm md:text-base text-left">How long does a typical LG service take?</span>
              </div>
              <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-4 ml-10">
              A standard LG service takes 45-60 minutes. Basic cleaning and filter checks take about 30-45 minutes, while comprehensive servicing with part replacements may take up to 90 minutes.
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none">
              <div class="flex items-center gap-3 pr-4">
                <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="font-medium text-slate-900 text-sm md:text-base text-left">Do you use genuine LG spare parts?</span>
              </div>
              <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-4 ml-10">
              Yes, we use 100% genuine and authorized spare parts for all LG purifiers. Every part comes with a manufacturer warranty. If the same issue recurs within our 90-day warranty, we fix it free of cost.
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none">
              <div class="flex items-center gap-3 pr-4">
                <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="font-medium text-slate-900 text-sm md:text-base text-left">Which LG models do you service?</span>
              </div>
              <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-4 ml-10">
              We service all LG water purifier models including PuriCare, WW Series, and all RO, UV, and UF variants. Our technicians are trained on the latest LG technology.
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none">
              <div class="flex items-center gap-3 pr-4">
                <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="font-medium text-slate-900 text-sm md:text-base text-left">Is there a visiting charge?</span>
              </div>
              <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-4 ml-10">
              No, we do not charge any visiting fee. Our technician inspects your LG purifier for free and gives you an honest quotation. You pay only if you decide to proceed with the repair.
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none">
              <div class="flex items-center gap-3 pr-4">
                <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <span class="font-medium text-slate-900 text-sm md:text-base text-left">How quickly can a technician reach my home?</span>
              </div>
              <svg class="w-5 h-5 text-slate-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-4 ml-10">
              For urgent cases, our technician reaches within 2-4 hours in most Bangalore areas. Regular bookings get same-day or next-day slots based on your convenience.
            </div>
          </details>

          <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none">
              <div class="flex items-center gap-3 pr-4">
                <div class="w-7 h-7 rounded-full bg-blue-50 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
