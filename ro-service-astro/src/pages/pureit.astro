---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const brandName = 'Pureit';
---

<Layout>
  <main class="bg-white">

    <!-- ==================== HERO SECTION (SEO + ADS OPTIMIZED) ==================== -->
    <section class="relative w-full flex items-start overflow-hidden border-b border-slate-200">
      
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/pureit-service.jpg" 
          alt="Pureit Water Purifier Service in Bangalore - Same Day Doorstep"
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-white/90 via-white/75 to-white/95 md:bg-gradient-to-r md:from-white/90 md:via-white/60 md:to-transparent"></div>
      </div>

      <!-- Content -->
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
        
        <!-- Small Tag -->
        <p class="text-[10px] md:text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          PUREIT RO SERVICE NEAR ME | SAME-DAY DOORSTEP REPAIR IN BANGALORE
        </p>

        <!-- Main Heading -->
        <h1 class="text-xl md:text-3xl font-black tracking-tight text-[#0c2b5e] leading-tight mb-1.5">
          Pureit Water Purifier Service in Bangalore
        </h1>

        <!-- Subheading -->
        <p class="text-sm md:text-xl font-bold text-[#0066cc] mb-2">
          Same Day Doorstep Service at ₹299 Only
        </p>

        <!-- Trust Line -->
        <p class="text-[11px] md:text-sm font-bold text-slate-800 mb-1.5">
          Verified Technicians · Genuine Parts · 90-Day Warranty
        </p>

        <!-- Description -->
        <p class="text-[11px] md:text-sm text-slate-700 leading-snug max-w-md mb-3">
          Book Pureit water purifier repair online — technician reaches in 60-90 minutes. Genuine GKK kit replacement, UV tube fix, motor repair, AMC plans. No visiting charge. 90-day service warranty. 20,000+ happy customers in Bangalore.
        </p>

        <!-- 6 Feature Badges -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-1.5 max-w-lg mb-3">
          
          <div class="flex items-center gap-1.5 bg-white/95 border border-slate-200 rounded-md px-2 py-1.5">
            <div class="w-3.5 h-3.5 rounded-full border border-blue-200 bg-blue-50 flex items-center justify-center shrink-0">
              <svg class="w-2 h-2 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <span class="text-[10px] md:text-[11px] font-semibold text-slate-800">Same-Day Doorstep</span>
          </div>

          <div class="flex items-center gap-1.5 bg-white/95 border border-slate-200 rounded-md px-2 py-1.5">
            <div class="w-3.5 h-3.5 rounded-full border border-blue-200 bg-blue-50 flex items-center justify-center shrink-0">
              <svg class="w-2 h-2 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <span class="text-[10px] md:text-[11px] font-semibold text-slate-800">Genuine GKK Kits</span>
          </div>

          <div class="flex items-center gap-1.5 bg-white/95 border border-slate-200 rounded-md px-2 py-1.5">
            <div class="w-3.5 h-3.5 rounded-full border border-blue-200 bg-blue-50 flex items-center justify-center shrink-0">
              <svg class="w-2 h-2 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <span class="text-[10px] md:text-[11px] font-semibold text-slate-800">₹299 Visiting Free</span>
          </div>

          <div class="flex items-center gap-1.5 bg-white/95 border border-slate-200 rounded-md px-2 py-1.5">
            <div class="w-3.5 h-3.5 rounded-full border border-blue-200 bg-blue-50 flex items-center justify-center shrink-0">
              <svg class="w-2 h-2 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
            </div>
            <span class="text-[10px] md:text-[11px] font-semibold text-slate-800">4.8★ (20,000+ Reviews)</span>
          </div>

          <div class="flex items-center gap-1.5 bg-white/95 border border-slate-200 rounded-md px-2 py-1.5">
            <div class="w-3.5 h-3.5 rounded-full border border-blue-200 bg-blue-50 flex items-center justify-center shrink-0">
              <svg class="w-2 h-2 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <span class="text-[10px] md:text-[11px] font-semibold text-slate-800">60-90 Min Response</span>
          </div>

          <div class="flex items-center gap-1.5 bg-white/95 border border-slate-200 rounded-md px-2 py-1.5">
            <div class="w-3.5 h-3.5 rounded-full border border-blue-200 bg-blue-50 flex items-center justify-center shrink-0">
              <svg class="w-2 h-2 text-[#0066cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <span class="text-[10px] md:text-[11px] font-semibold text-slate-800">90-Day Warranty</span>
          </div>

        </div>

        <!-- CTA Button -->
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <a href="tel:+917090170092" class="bg-[#0066cc] hover:bg-[#0055b3] text-white text-xs md:text-sm font-bold px-3 md:px-5 py-2 md:py-2.5 rounded-lg shadow-sm transition-all flex items-center gap-1.5">
            <svg class="w-3 h-3 md:w-3.5 md:h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/></svg>
            <span>Call Now — Book Pureit Service</span>
          </a>
        </div>

        <!-- Rating -->
        <div class="flex items-center gap-2 flex-wrap">
          <div class="flex items-center gap-1 bg-white/90 border border-slate-200 rounded-full px-2 py-0.5">
            <span class="text-yellow-500 text-[11px]">★★★★★</span>
            <span class="text-[11px] font-extrabold text-slate-900">4.8</span>
          </div>
          <span class="text-[10px] md:text-xs font-semibold text-slate-800">
            <span class="font-bold text-slate-950">20,000+</span> happy customers
          </span>
        </div>

      </div>
    </section>

    <!-- ==================== FORM SECTION ==================== -->
    <section class="pb-10 md:pb-14 px-4 bg-slate-50 pt-6 md:pt-8">
      <div class="max-w-md mx-auto">
        
        <h2 class="text-2xl md:text-3xl font-bold text-blue-900 text-center leading-tight mb-2">
          Register Service Request
        </h2>

        <p class="text-sm text-slate-500 text-center mb-6 leading-relaxed max-w-sm mx-auto">
          Fill the form below and our team will call you back within <strong class="text-slate-700">30 minutes</strong>. Same-day doorstep service available.
        </p>

        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          
          <div class="bg-blue-900 text-white text-center py-3">
            <p class="text-xs font-semibold tracking-widest uppercase">Book Your Service</p>
          </div>

          <form id="bookingForm" class="p-5 md:p-6 space-y-3">
            
            <input type="text" id="fullName" name="name" placeholder="Your Full Name" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <input type="tel" id="mobile" name="mobile" placeholder="Mobile Number" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <input type="text" id="pincode" name="pincode" placeholder="PinCode" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <input type="text" id="address" name="address" placeholder="Full Address" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm" required>
            
            <select id="serviceType" name="service" class="w-full p-3.5 rounded-md bg-slate-50 border border-slate-200 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:bg-white transition text-sm cursor-pointer" required>
              <option value="" disabled selected>Select Service Type</option>
              <option value="Pureit Water Purifier Service">Pureit Water Purifier Service</option>
              <option value="Pureit Water Purifier Repair">Pureit Water Purifier Repair</option>
              <option value="Pureit Water Purifier Installation">Pureit Water Purifier Installation</option>
              <option value="Pureit Water Purifier AMC Plan">Pureit Water Purifier AMC Plan</option>
              <option value="Pureit GKK Kit Replacement">Pureit GKK Kit Replacement</option>
            </select>

            <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3.5 rounded-md transition duration-300 text-sm tracking-wide">
              Book Service Now
            </button>

            <p class="text-[11px] text-slate-500 text-center flex items-center justify-center gap-1.5 pt-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
              100% secure. We never share your data.
            </p>
          </form>
        </div>

      </div>
    </section>

    <!-- DIVIDER -->
    <div class="max-w-md mx-auto px-4">
      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-slate-200"></div>
        <div class="text-slate-300 text-xs">◆</div>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>
    </div>

    <!-- TRUST HEADLINE + STATS -->
    <section class="py-8 px-4 bg-white">
      <div class="max-w-md mx-auto text-center">
        
        <p class="text-sm md:text-base text-slate-600 leading-relaxed mb-4">
          <strong class="text-slate-900">Our Pureit Water Purifier Service in Bangalore</strong>
        </p>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <p class="text-xl md:text-2xl font-bold text-blue-900">15+</p>
            <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wide">Years Experience</p>
          </div>
          <div>
            <p class="text-xl md:text-2xl font-bold text-blue-900">20,000+</p>
            <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wide">Happy Families</p>
          </div>
          <div>
            <p class="text-xl md:text-2xl font-bold text-blue-900">4.8★</p>
            <p class="text-[10px] text-slate-500 mt-0.5 uppercase tracking-wide">Average Rating</p>
          </div>
        </div>

        <p class="text-xs md:text-sm text-slate-500 mt-4 leading-relaxed">
          Certified technicians · Genuine spare parts · Transparent pricing · 90-day service warranty
        </p>
      </div>
    </section>

    <!-- TRUST IMAGE SECTION -->
    <section class="py-6 px-4 bg-white">
      <div class="max-w-md mx-auto">
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
          <img 
            src="/trust-image.jpg" 
            alt="Certified RO Technician"
            width="800" height="600" loading="lazy" class="w-full h-52 md:h-60 object-cover"
          />
        </div>
        <div class="mt-4 text-center">
          <p class="text-sm font-semibold text-slate-700">Certified & Verified Technicians</p>
          <p class="text-xs text-slate-500 mt-1">Trained on all major water purifier brands</p>
        </div>
      </div>
    </section>

    <!-- DIVIDER -->
    <div class="max-w-md mx-auto px-4">
      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-slate-200"></div>
        <div class="text-slate-300 text-xs">◆</div>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>
    </div>

    <!-- TRUST POINTS -->
    <section class="py-10 px-4">
      <div class="max-w-md mx-auto grid grid-cols-3 gap-3 text-center">
        
        <div>
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <p class="text-xs font-bold text-slate-900">Same Day</p>
          <p class="text-[10px] text-slate-500 mt-0.5">Service</p>
        </div>

        <div>
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <p class="text-xs font-bold text-slate-900">Genuine</p>
          <p class="text-[10px] text-slate-500 mt-0.5">Parts</p>
        </div>

        <div>
          <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <p class="text-xs font-bold text-slate-900">90-Day</p>
          <p class="text-[10px] text-slate-500 mt-0.5">Warranty</p>
        </div>

      </div>
    </section>

    <!-- SEO CONTENT SECTION -->
    <section class="py-12 px-4 bg-white border-t border-slate-100">
      <div class="max-w-3xl mx-auto">
        
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
          Everything You Need to Know About Pureit Purifier Service
        </h2>
        
        <div class="space-y-4 text-sm md:text-base text-slate-600 leading-relaxed">
          
          <p>
            Pureit by Hindustan Unilever is one of India's most trusted water purifier brands, known for its Germkill Kit (GKK) technology and reliable performance. However, like any water purifier, Pureit systems require regular servicing to maintain peak performance — especially in Bangalore where water TDS often exceeds 500 ppm.
          </p>

          <p>
            At Rofix Service, we have over 15 years of experience servicing Pureit water purifiers across Bangalore. Our certified technicians are trained on all Pureit models, including Marvella, Ultima, Copper RO+UV, Mineral RO, and Classic series. Whether you need a GKK kit replacement or a complex motor repair, we handle everything at your doorstep.
          </p>

          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-3">
            Common Pureit Purifier Problems We Fix
          </h3>

          <ul class="space-y-2 list-disc pl-5">
            <li><strong>GKK indicator red</strong> — Water lock activated, needs GKK replacement</li>
            <li><strong>No water output</strong> — Clogged filter or solenoid valve issue</li>
            <li><strong>Continuous beeping</strong> — Error code or GKK lifecycle expired</li>
            <li><strong>Water leakage</strong> — Worn O-rings or GKK chamber issue</li>
            <li><strong>Booster pump humming</strong> — Motor failure or low inlet pressure</li>
            <li><strong>High TDS output</strong> — Exhausted RO membrane</li>
            <li><strong>Bad taste</strong> — Post-carbon filter exhausted</li>
          </ul>

          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-3">
            Why Choose Rofix Service for Your Pureit Purifier?
          </h3>

          <ul class="space-y-2 list-disc pl-5">
            <li><strong>Certified technicians</strong> — Trained on all Pureit models</li>
            <li><strong>Genuine GKK kits</strong> — Factory-sealed 1500L, 2000L, 3000L, 6000L</li>
            <li><strong>Same-day service</strong> — Book before 2 PM, service today</li>
            <li><strong>Transparent pricing</strong> — Written quote before work begins</li>
            <li><strong>90-day warranty</strong> — On all repairs and spare parts</li>
            <li><strong>Doorstep service</strong> — No need to carry your purifier anywhere</li>
          </ul>

          <h3 class="text-xl font-bold text-slate-900 mt-6 mb-3">
            How Often Should You Service Your Pureit Purifier?
          </h3>

          <p>
            In Bangalore's water conditions, we recommend servicing your Pureit purifier <strong>every 4-6 months</strong>. GKK kits should be replaced as per the manufacturer's guidelines — typically once a year or after 3000-6000 liters. Regular servicing not only keeps your water safe but also extends the life of your purifier by 3-5 years.
          </p>

          <p>
            If you notice any of these signs, book a service immediately: slow water flow, unusual taste, TDS above 150 ppm, or any leakage. Ignoring these signs can lead to expensive repairs later.
          </p>

        </div>
      </div>
    </section>

    <!-- SERVICES SIMPLE LIST -->
    <section id="services" class="py-12 px-4 bg-slate-50 border-y border-slate-100">
      <div class="max-w-md mx-auto">
        
        <div class="text-center mb-6">
          <p class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold mb-1">What We Offer</p>
          <h2 class="text-xl font-bold text-slate-900">
            Our Pureit Water Purifier Services
          </h2>
        </div>

        <div class="space-y-2">
          
          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Installation of all Pureit models</span>
          </div>

          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Repair of leaks, motor & TDS issues</span>
          </div>

          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Genuine GKK kit replacement</span>
          </div>

          <div class="flex items-center gap-3 p-4 bg-white rounded-md border border-slate-200">
            <div class="w-6 h-6 bg-blue-900 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm text-slate-700 font-medium">Affordable AMC plans for Pureit purifiers</span>
          </div>

        </div>

      </div>
    </section>

    <!-- FAQ SECTION -->
    <section id="faq" class="py-12 md:py-16 px-4 bg-white">
      <div class="max-w-3xl mx-auto">
        
        <div class="text-center mb-8">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-3">
            Frequently Asked <span class="text-blue-600">Questions</span>
          </h2>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed max-w-xl mx-auto">
            Common questions about Pureit water purifier service in Bangalore.
          </p>
        </div>

        <div class="space-y-3">
          
          <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden">
            <summary class="flex justify-between items-center p-5 cursor-pointer list-none">
