---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="p-8 max-w-md mx-auto">
    <h1 class="text-2xl font-bold mb-4">Test Form</h1>
    
    <form action="https://formsubmit.co/syedsmaula786@gmail.com" method="POST">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_subject" value="Test Form - Rofix Service">
      
      <input 
        type="text" 
        name="name" 
        placeholder="Your Name" 
        class="w-full p-3 border rounded mb-3" 
        required
      >
      
      <input 
        type="email" 
        name="email" 
        placeholder="Your Email" 
        class="w-full p-3 border rounded mb-3" 
        required
      >
      
      <button type="submit" class="w-full bg-blue-600 text-white p-3 rounded">
        Test Submit
      </button>
    </form>
  </main>
</Layout>