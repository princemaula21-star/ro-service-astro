---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="py-16 px-4 bg-slate-50 min-h-screen flex items-center">
    <div class="max-w-lg mx-auto text-center">
      
      <!-- Success Icon -->
      <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <!-- Heading -->
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
        Thank You! 🎉
      </h1>
      <p class="text-slate-600 text-sm md:text-base mb-6">
        Your service request has been submitted successfully. Our team will contact you within <strong class="text-blue-900">30 minutes</strong>.
      </p>

      <!-- Booking ID Box -->
      <div class="bg-blue-900 rounded-xl p-5 mb-8">
        <p class="text-blue-200 text-xs uppercase tracking-wider font-semibold mb-1">Your Booking ID</p>
        <p id="bookingIdDisplay" class="text-white text-2xl font-extrabold tracking-wider">Loading...</p>
        <p class="text-blue-200 text-[11px] mt-2">Please save this ID for future reference</p>
      </div>

      <!-- What Happens Next -->
      <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 mb-8 text-left">
        <h3 class="font-bold text-slate-900 text-lg mb-4 text-center">What Happens Next?</h3>
        
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <div class="bg-blue-100 text-blue-900 w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">1</div>
            <div>
              <h4 class="font-semibold text-slate-900 text-sm">Confirmation Call</h4>
              <p class="text-xs text-slate-500 mt-0.5">We will call you to confirm the service details.</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <div class="bg-blue-100 text-blue-900 w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">2</div>
            <div>
              <h4 class="font-semibold text-slate-900 text-sm">Technician Visit</h4>
              <p class="text-xs text-slate-500 mt-0.5">A certified technician will visit your home at the scheduled time.</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <div class="bg-blue-100 text-blue-900 w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">3</div>
            <div>
              <h4 class="font-semibold text-slate-900 text-sm">Problem Solved</h4>
              <p class="text-xs text-slate-500 mt-0.5">Repair with genuine parts, backed by a 90-day warranty.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Urgent Help -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
        <p class="text-sm text-slate-600 mb-3 font-medium">Need urgent help? Call us now:</p>
        
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="tel:+919008315606" class="flex-1 inline-flex items-center justify-center gap-2 bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3 px-6 rounded-xl transition text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call Now
          </a>
          
          <a href="https://wa.me/919008315606" target="_blank" class="flex-1 inline-flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-xl transition text-sm">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Back to Home -->
      <a href="/" class="inline-block mt-8 text-blue-900 font-bold text-sm hover:underline">
        ← Back to Home
      </a>

    </div>
  </main>
</Layout>

<script>
  // Read Booking ID from sessionStorage
  let bookingId = sessionStorage.getItem('bookingId');
  
  // Fallback: try URL parameter
  if (!bookingId) {
    const params = new URLSearchParams(window.location.search);
    bookingId = params.get('bookingId');
  }
  
  const display = document.getElementById('bookingIdDisplay');
  if (bookingId && display) {
    display.textContent = bookingId;
  } else if (display) {
    display.textContent = 'RFX-NOT-FOUND';
  }
</script>